PORT=3000

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=facturaBonita
DB_POOL_SIZE=15

ENCRYPTION_KEY=

# Consumo desde distintos proyectos
CORS_ALLOW_ALL=true
FRONTEND_URL=

# Render PDF
DOCUMENT_RENDERER_TIMEOUT_MS=15000
PDF_MAX_CONCURRENCY=2
PDF_MAX_QUEUE=40
PDF_CACHE_TTL_MS=300000
PDF_CACHE_MAX=40
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_CACHE_DIR=

# URLs públicas del servicio
PUBLIC_APP_URL=
PUBLIC_API_URL=

# Factura Bonita no procesa pagos, firma digital, factura electrónica ni tributación.
# Esos servicios son orquestados por el sistema cliente (por ejemplo EduControl).

# El PDF se consulta mediante /api/documentos/facturas/:id?formato=pdf.
