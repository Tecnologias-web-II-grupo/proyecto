PORT=3000

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=facturaBonita
DB_POOL_SIZE=15

ENCRYPTION_KEY=

# API compartida: por defecto permite consumo desde distintos proyectos.
# Para restringirla, usa CORS_ALLOW_ALL=false y una lista en FRONTEND_URL.
CORS_ALLOW_ALL=true
FRONTEND_URL=

# Render PDF
DOCUMENT_RENDERER_TIMEOUT_MS=15000
PDF_MAX_CONCURRENCY=2
PDF_MAX_QUEUE=40
PDF_CACHE_TTL_MS=300000
PDF_CACHE_MAX=40

# Opcional si el entorno ya proporciona Chrome/Chromium.
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_CACHE_DIR=


# Portal web e integración entre servicios
PUBLIC_APP_URL=
PUBLIC_API_URL=

# Servicio bancario compartido
BANK_CHECKOUT_URL=https://bankyfinanzas.netlify.app/checkout
BANK_ALLOWED_ORIGIN=https://bankyfinanzas.netlify.app
# Si el banco ofrece un endpoint server-to-server para verificar pagos, colócalo aquí.
BANK_VERIFY_URL=
BANK_VERIFY_TIMEOUT_MS=12000
# postmessage permite la demo con una ventana del banco que responda mediante window.postMessage.
BANK_CONFIRM_MODE=postmessage
# Si el banco implementa callback servidor a servidor, ambos grupos acuerdan este secreto.
BANK_CALLBACK_SECRET=

# APIs posteriores al banco. Se ejecutan en orden y la factura solo se crea si todas responden correctamente.
# Ejemplo: [{"name":"servicio-x","url":"https://.../procesar","method":"POST"}]
SERVICE_PIPELINE_JSON=[]
