PORT=3000

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=facturaBonita
DB_POOL_SIZE=15

ENCRYPTION_KEY=

# Consumo desde distintos proyectos
CORS_ALLOW_ALL=true
FRONTEND_URL=

# Render PDF
DOCUMENT_RENDERER_TIMEOUT_MS=15000
PDF_MAX_CONCURRENCY=2
PDF_MAX_QUEUE=40
PDF_CACHE_TTL_MS=300000
PDF_CACHE_MAX=40
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_CACHE_DIR=

# URLs públicas del servicio
PUBLIC_APP_URL=
PUBLIC_API_URL=

# Servicio bancario
BANK_LOGIN_URL=https://bankyfinanzas.netlify.app/login
BANK_REGISTER_URL=https://bankyfinanzas.netlify.app/registro/negocio
BANK_CHECKOUT_URL=https://bankyfinanzas.netlify.app/checkout
BANK_ALLOWED_ORIGIN=https://bankyfinanzas.netlify.app
BANK_VERIFY_URL=
BANK_VERIFY_TIMEOUT_MS=12000
BANK_CONFIRM_MODE=postmessage
BANK_CALLBACK_SECRET=

# Comercio enviado al checkout. Si BANK_MERCHANT_ID queda vacío,
# se usa la identificación del negocio registrado en Factura Bonita.
BANK_MERCHANT_ID=
BANK_MERCHANT_PARAM=merchant
BANK_MERCHANT_ALIASES=true

# Servicios que se ejecutarán después de aprobar el pago y antes de facturar.
# Ejemplo: [{"name":"servicio-x","url":"https://.../procesar","method":"POST"}]
SERVICE_PIPELINE_JSON=[]

# Identificación del proveedor del sistema en el contrato ampliado de la factura
SYSTEM_PROVIDER_NAME=API Factura
SYSTEM_PROVIDER_ID=3-101-999999

# IMPORTANTE PARA BANKYFINANZAS:
# El comercio debe estar previamente afiliado/registrado por el servicio bancario.
# Si el banco entrega un identificador propio de comercio, colóquelo en BANK_MERCHANT_ID.
# Integración BankyFinanzas
# El identificador correcto se obtiene en BankyFinanzas > Credenciales API.
# El checkout responde al navegador mediante postMessage con:
# { channel: 'bankyfinanzas:checkout', result: { status, paymentId, transactionCode, ... } }
# El parámetro origin es agregado automáticamente al checkout para que el resultado vuelva a este portal.


# ================================================================
# MODO DE PRUEBA DEL ECOSISTEMA
# ================================================================
# false = Banco -> Factura Bonita -> correo (sin esperar otros grupos)
# true  = Firma Digital -> Facturación Electrónica -> Tributación -> correo
ECOSYSTEM_ENABLED=false

# Envío directo por correo para probar sin otro microservicio.
# Opción simple de prueba tipo <form action>: FormSubmit.
# La primera vez que se use un correo destinatario, FormSubmit puede enviarle
# una confirmación de activación. Confírmala y luego reintenta el procesamiento.
DIRECT_EMAIL_PROVIDER=formsubmit
FORM_ACTION_URL_TEMPLATE=https://formsubmit.co/ajax/{email}

# Alternativa recomendada para producción: Resend.
# Para usarla cambia DIRECT_EMAIL_PROVIDER=resend y configura RESEND_API_KEY.
RESEND_API_KEY=
EMAIL_FROM=Factura Bonita <onboarding@resend.dev>
EMAIL_REPLY_TO=

# ================================================================
# ECOSISTEMA DEL PROYECTO - PEGAR AQUÍ LOS ENDPOINTS DE LOS GRUPOS
# ================================================================
# 1) Firma digital: valida que el negocio esté registrado/habilitado.
DIGITAL_SIGNATURE_VALIDATE_URL=
DIGITAL_SIGNATURE_API_KEY=
DIGITAL_SIGNATURE_BEARER_TOKEN=
DIGITAL_SIGNATURE_TIMEOUT_MS=18000

# 2) Facturación electrónica: recibe nuestra factura visual/JSON y debe
# devolver el XML, XML en base64 o una URL donde descargarlo.
ELECTRONIC_INVOICE_URL=
ELECTRONIC_INVOICE_API_KEY=
ELECTRONIC_INVOICE_BEARER_TOKEN=
ELECTRONIC_INVOICE_TIMEOUT_MS=25000

# 3) Tributación / Administración Directa: recibe la factura electrónica
# y debe devolver aceptación + acuse (contenido, base64 o URL).
TAXATION_URL=
TAXATION_API_KEY=
TAXATION_BEARER_TOKEN=
TAXATION_TIMEOUT_MS=25000

# 4) Entrega final al correo del cliente.
# Este endpoint recibe destinatario + 3 adjuntos en base64. Puede ser un
# microservicio propio de correo o el adaptador que el grupo elija.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_API_KEY=
EMAIL_DELIVERY_BEARER_TOKEN=
EMAIL_DELIVERY_TIMEOUT_MS=25000
