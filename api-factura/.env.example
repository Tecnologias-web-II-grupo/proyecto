PORT=3000

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=facturaBonita
DB_POOL_SIZE=15

ENCRYPTION_KEY=

# Consumo desde distintos proyectos
CORS_ALLOW_ALL=true
FRONTEND_URL=

# Render PDF
DOCUMENT_RENDERER_TIMEOUT_MS=15000
PDF_MAX_CONCURRENCY=2
PDF_MAX_QUEUE=40
PDF_CACHE_TTL_MS=300000
PDF_CACHE_MAX=40
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_CACHE_DIR=

# URLs públicas del servicio
PUBLIC_APP_URL=
PUBLIC_API_URL=

# Servicio bancario
BANK_CHECKOUT_URL=https://bankyfinanzas.netlify.app/checkout
BANK_ALLOWED_ORIGIN=https://bankyfinanzas.netlify.app
BANK_VERIFY_URL=
BANK_VERIFY_TIMEOUT_MS=12000
BANK_CONFIRM_MODE=postmessage
BANK_CALLBACK_SECRET=

# Comercio enviado al checkout. Si BANK_MERCHANT_ID queda vacío,
# se usa la identificación del negocio registrado en Factura Bonita.
BANK_MERCHANT_ID=
BANK_MERCHANT_PARAM=merchant
BANK_MERCHANT_ALIASES=true

# Servicios que se ejecutarán después de aprobar el pago y antes de facturar.
# Ejemplo: [{"name":"servicio-x","url":"https://.../procesar","method":"POST"}]
SERVICE_PIPELINE_JSON=[]

# Identificación del proveedor del sistema en el contrato ampliado de la factura
SYSTEM_PROVIDER_NAME=API Factura
SYSTEM_PROVIDER_ID=3-101-999999
